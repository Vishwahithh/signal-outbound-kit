# Copy to .env and fill in your own keys. .env is git-ignored; never commit it.
PROSPEO_API_KEY=
MILLIONVERIFIER_API_KEY=
# Sending side: inbox_health, seed_test, replies, monitor
SMARTLEAD_API_KEY=
# Optional: monitor.py summary to Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ATTIO_API_KEY=
# Optional paid fallbacks for sites the free crawler cannot read
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
EXA_API_KEY=
# Person research (scripts/person_research.py). One or more Apify tokens, comma-separated; runs rotate across them
APIFY_TOKENS=
# Optional: dated company events for person_research.py --explorium-events
EXPLORIUM_API_KEY=
